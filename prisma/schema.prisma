generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationLevel {
  VERIFIED
  TRUSTED
  AMBASSADOR
}

enum MarketplaceStatus {
  AVAILABLE
  PENDING
  SOLD
}

enum RideSeatStatus {
  SEATS_OPEN
  WAITLIST
}

enum RideMode {
  OFFER
  REQUEST
}

enum ConversationContextType {
  GENERAL
  MARKETPLACE
  RIDE
  STUDY_GROUP
}

model User {
  id                    String             @id @default(cuid())
  email                 String             @unique
  name                  String
  passwordHash          String?
  program               String
  year                  String
  avatar                String
  rating                Float              @default(5)
  reviewsCount          Int                @default(0)
  verificationLevel     VerificationLevel  @default(VERIFIED)
  verifiedAt            DateTime?
  completedTransactions Int                @default(0)
  ridesGiven            Int                @default(0)
  groupsHosted          Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  marketplaceListings   MarketplaceListing[]
  rideListings          RideListing[]
  studyGroups           StudyGroup[]       @relation("StudyGroupHost")
  sentMessages          Message[]          @relation("MessageSender")
  conversationLinks     ConversationParticipant[]
  authoredReviews       Review[]           @relation("ReviewAuthor")
  receivedReviews       Review[]           @relation("ReviewSubject")
  rideSeatRequests      RideSeatRequest[]
  studyGroupMemberships StudyGroupMember[]
}

model MarketplaceListing {
  id          String            @id @default(cuid())
  sellerId    String
  title       String
  description String
  price       Int
  postedAt    String
  location    String
  category    String
  status      MarketplaceStatus @default(AVAILABLE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([status])
  @@index([sellerId])
}

model RideListing {
  id           String         @id @default(cuid())
  driverId     String
  route        String
  departure    String
  pricePerSeat Int
  seats        Int
  seatStatus   RideSeatStatus @default(SEATS_OPEN)
  mode         RideMode       @default(OFFER)
  car          String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  driver User @relation(fields: [driverId], references: [id], onDelete: Cascade)
  seatRequests RideSeatRequest[]

  @@index([driverId])
  @@index([seatStatus])
  @@index([mode])
}

model StudyGroup {
  id        String   @id @default(cuid())
  hostId    String
  course    String
  title     String
  schedule  String
  location  String
  seatsLeft Int
  focus     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host User @relation("StudyGroupHost", fields: [hostId], references: [id], onDelete: Cascade)
  members StudyGroupMember[]

  @@index([hostId])
  @@index([course])
}

model RideSeatRequest {
  id        String   @id @default(cuid())
  rideId    String
  userId    String
  createdAt DateTime @default(now())

  ride RideListing @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rideId, userId])
  @@index([userId])
}

model StudyGroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  joinedAt  DateTime @default(now())

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Conversation {
  id          String                  @id @default(cuid())
  contextType ConversationContextType @default(GENERAL)
  contextId   String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([contextType, contextId])
}

model ConversationParticipant {
  id             String @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Review {
  id        String   @id @default(cuid())
  authorId  String
  subjectId String
  subject   String
  body      String
  rating    Float
  createdAt DateTime @default(now())

  author  User @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subjectUser User @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([subjectId])
}
